TELEGRAM_BOT_TOKEN=put_your_bot_token_here
ALLOWED_TELEGRAM_USER_IDS=123456789
APP_ENV=production
ENABLE_DEV_AUTH=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
API_RATE_LIMIT_READS=120
API_RATE_LIMIT_MUTATIONS=30
BUSINESS_TIMEZONE=Europe/Moscow
DATABASE_PATH=data/trading_bot.sqlite3
AUTO_MIGRATE=false

# Crisis Radar. FRED key registration is free: https://fred.stlouisfed.org/docs/api/api_key.html
CRISIS_RADAR_ENABLED=true
FRED_API_KEY=
CRISIS_RADAR_SYNC_MINUTES=60

# Crisis Radar v2 is released component-by-component. The master flag enables every
# component unless an individual flag explicitly overrides it.
CRISIS_RADAR_V2_ENABLED=false
CRISIS_RADAR_COVERAGE_GATE_ENABLED=false
CRISIS_RADAR_THRESHOLDS_V2_ENABLED=false
CRISIS_RADAR_GLOBAL_SOURCES_V2_ENABLED=false
CRISIS_RADAR_NEWS_EVENTS_V2_ENABLED=false
CRISIS_RADAR_EVIDENCE_MEMORY_V2_ENABLED=false
CRISIS_RADAR_TREND_ENGINE_V2_ENABLED=false
CRISIS_RADAR_SCENARIO_FUSION_V2_ENABLED=false

# Optional read-only local explainer for Crisis Radar. Ollama must be running locally.
CRISIS_AGENT_ENABLED=true
CRISIS_AGENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
CRISIS_AGENT_MODEL=qwen3.5:9b
CRISIS_AGENT_API_KEY=
CRISIS_AGENT_BASE_URL=
ANTHROPIC_API_KEY=
CRISIS_AGENT_TIMEOUT_SECONDS=90
CRISIS_AGENT_RATE_LIMIT=6
CRISIS_AGENT_KEEP_ALIVE_MINUTES=10
CRISIS_AGENT_COOLDOWN_SECONDS=120

# Reserved for the next official-data adapters; both registrations are free.
# https://apps.bea.gov/api/signup/  (GDP, income, corporate profits)
BEA_API_KEY=
# https://www.eia.gov/opendata/register.php  (oil, gas, inventories, energy shocks)
EIA_API_KEY=

# futures or spot
MARKET=futures

# Defaults for /top and price-alert polling.
TOP_LIMIT=10
ALERT_POLL_SECONDS=30

# Optional screenshot-to-trade recognition for Telegram /open.
# If OPENAI_API_KEY is empty, the bot falls back to the manual /open template.
# The Models tab reports this binding but never accepts or returns the key.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5

# Mini App local server.
WEB_APP_URL=http://127.0.0.1:8080
WEB_HOST=127.0.0.1
WEB_PORT=8080
TRADE_UPLOAD_DIR=data/trade_uploads
