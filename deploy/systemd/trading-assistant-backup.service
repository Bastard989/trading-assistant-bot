[Unit]
Description=Trading Assistant verified SQLite backup

[Service]
Type=oneshot
User=trading-assistant
Group=trading-assistant
WorkingDirectory=/opt/trading-assistant/current
EnvironmentFile=/etc/trading-assistant.env
ExecStart=/opt/trading-assistant/current/.venv/bin/python scripts/backup_daily.py --source ${DATABASE_PATH} --directory ${BACKUP_DIRECTORY} --age-recipient ${BACKUP_AGE_RECIPIENT} --off-host-directory ${OFF_HOST_BACKUP_DIRECTORY} --apply-retention --daily 7 --weekly 4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trading-assistant
UMask=0077
